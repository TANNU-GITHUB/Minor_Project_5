# Copy this file to .env and fill in your values

# Set to "true" for dev mode (no API credits used), "false" for production
MOCK_ANALYSIS=true

# Free Groq API key — https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Pinecone vector DB — https://pinecone.io (free tier)
PINECONE_API_KEY=your_key_here
PINECONE_ENV=gcp-starter

# PostgreSQL connection string
DATABASE_URL=postgresql://tb:password@localhost:5432/tonguebridge

# Redis connection string
REDIS_URL=redis://localhost:6379

# Your frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AWS (only needed for production deployment)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=tonguebridge-audio

# Stripe (optional — for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=